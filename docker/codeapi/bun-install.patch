diff --git a/service/Dockerfile b/service/Dockerfile
index 762790d..444a915 100644
--- a/service/Dockerfile
+++ b/service/Dockerfile
@@ -6,11 +6,23 @@ WORKDIR /app
 FROM base AS install
 RUN mkdir -p /temp/dev
 COPY service/package.json service/bun.lock /temp/dev/
-RUN cd /temp/dev && bun install --frozen-lockfile
+RUN set -eu; \
+    for attempt in 1 2 3; do \
+      if cd /temp/dev && bun install --frozen-lockfile; then exit 0; fi; \
+      rm -rf /root/.bun/install/cache /temp/dev/node_modules; \
+      [ "$attempt" -eq 3 ] && exit 1; \
+      sleep 5; \
+    done
 
 RUN mkdir -p /temp/prod
 COPY service/package.json service/bun.lock /temp/prod/
-RUN cd /temp/prod && bun install --frozen-lockfile --production
+RUN set -eu; \
+    for attempt in 1 2 3; do \
+      if cd /temp/prod && bun install --frozen-lockfile --production; then exit 0; fi; \
+      rm -rf /root/.bun/install/cache /temp/prod/node_modules; \
+      [ "$attempt" -eq 3 ] && exit 1; \
+      sleep 5; \
+    done
 
 # Build all entry points
 FROM base AS builder
