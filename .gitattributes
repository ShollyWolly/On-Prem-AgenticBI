# Container-executed text files must retain LF line endings.
* text=auto eol=lf

*.sql        text eol=lf
*.sh         text eol=lf
*.yml        text eol=lf
*.yaml       text eol=lf
*.py         text eol=lf
*.js         text eol=lf
*.env        text eol=lf
*.md         text eol=lf
*.toml       text eol=lf
Dockerfile   text eol=lf
.gitattributes text eol=lf
.editorconfig  text eol=lf


# Never touch these.
*.png binary
*.jpg binary
*.zip binary
*.parquet binary
