# CRLF is a structural failure mode here, not a style preference.
# A .sql or .sh file with CRLF that gets bind-mounted into a Linux container
# dies with `$'\r': command not found` or a psql syntax error.
* text=auto eol=lf

*.sql        text eol=lf
*.sh         text eol=lf
*.yml        text eol=lf
*.yaml       text eol=lf
*.py         text eol=lf
*.js         text eol=lf
*.env        text eol=lf
*.md         text eol=lf
*.toml       text eol=lf
Dockerfile   text eol=lf
.gitattributes text eol=lf
.editorconfig  text eol=lf


# Never touch these.
*.png binary
*.jpg binary
*.zip binary
*.parquet binary
