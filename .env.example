# On-Prem Agentic BI PoC -- environment
# Copy to .env. This demo includes its local service credentials; only Azure
# Foundry credentials remain placeholders.
# See docs/TRAPS.md for the rationale behind anything marked load-bearing below.

# ---- Stable secrets: changing these after first boot BREAKS the stack -------
# Regenerating SUPERSET_SECRET_KEY makes every stored DB credential (incl. the
# Cube connection) undecryptable, and it is not self-healing. Generate once.
SUPERSET_SECRET_KEY=j7NrXGd8pg5CzXJTcGNP4pAaFYV84B1KiRmTVxVPVNgPGAXi
CUBEJS_API_SECRET=62671da0ff86e7a22532fe040eed7953577ab754d141952ddb94852a46f52806

# ---- Postgres: demo warehouse (Pagila) + Superset metadata, same instance ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=rPdZli133S98Mm8YxOMy70G0MAVb
POSTGRES_DB=pagila

SUPERSET_DB_NAME=superset
SUPERSET_DB_USER=superset
SUPERSET_DB_PASSWORD=t9tS0k8aIoPRII9NIoFNfcrFgl5p

# SELECT-only, what Cube reads the warehouse as.
CUBE_DB_USER=cube_ro
CUBE_DB_PASSWORD=n4vail48i9D51Wvdcr9CgLDMWIMl

# RAG API vector store -- a third database in the same Postgres instance.
VECTOR_DB_NAME=vectordb
VECTOR_DB_USER=vectoruser
VECTOR_DB_PASSWORD=4syiQCGXB3Xk0sJ3uFTVPZXQ50Cf

# ---- OpenLDAP: the single userstore for Superset AND LibreChat --------------
# No published port -- reachable only on the compose network. Quoted because a
# space in an unquoted value makes `. ./.env` try to execute it.
LDAP_ORGANISATION="Demo Corp"
LDAP_DOMAIN=demo.local
LDAP_BASE_DN=dc=demo,dc=local
LDAP_ADMIN_DN=cn=admin,dc=demo,dc=local
LDAP_ADMIN_PASSWORD=ovGaFEOG42djnh5EyS21nZ9TsUDJ

# ---- Cube SQL API (Postgres wire protocol on :15432) ------------------------
# Alphanumeric only -- superset-init injects this unencoded into a SQLAlchemy URI.
CUBEJS_SQL_PASSWORD=l6jFsMDHPjZXebicquWfX7YNwuIdoMMC3AX1a6EZMV

# The SQL user Superset connects as; determines what the DASHBOARD shows.
# analyst = masked PII (recommended). admin@demo.local = unmasked.
SUPERSET_CUBE_SQL_USER=analyst@demo.local

# Required by Cube startup; checkSqlAuth ignores it.
CUBEJS_SQL_USER=cube

# THE governance boundary: read by config/cube/cube.js. Any e-mail not listed
# resolves to `denied`, which matches no access_policy. Must be single-line JSON.
CUBE_USER_ROLE_MAP={"analyst@demo.local":{"role":"analyst"},"admin@demo.local":{"role":"admin"}}

# ---- Superset admin ----------------------------------------------------------
SUPERSET_ADMIN_USER=admin
# Break-glass: falls back to Superset's local table if LDAP is unreachable.
# SUPERSET_AUTH=db
# Deliberately no separate password: admin@demo.local is one identity, wired to
# DEMO_ADMIN_PASSWORD in docker-compose.yml.
SUPERSET_ADMIN_EMAIL=admin@demo.local

# ---- Demo users: one LDAP credential per person, both front doors ----------
# Must match the keys in CUBE_USER_ROLE_MAP above.
DEMO_ANALYST_EMAIL=analyst@demo.local
DEMO_ANALYST_PASSWORD=fH8tXg7uSQK5HfYFpJBl
DEMO_ADMIN_EMAIL=admin@demo.local
DEMO_ADMIN_PASSWORD=xa3ab0WPGmeicsQuagfr

# ---- LibreChat core ----------------------------------------------------------
# CREDS_KEY must be exactly 64 hex chars, CREDS_IV exactly 32 -- LibreChat
# crashes at boot on any other length.
HOST=0.0.0.0
PORT=3080
MONGO_URI=mongodb://mongodb:27017/LibreChat
DOMAIN_CLIENT=http://localhost:3080
DOMAIN_SERVER=http://localhost:3080
CONFIG_PATH=/app/librechat.yaml

CREDS_KEY=8133005528f2b734ccc13c8ebd912d6d43039aa179f489f566d56c036747dce4
CREDS_IV=efe510e7dc9d09d99c0a98fdeefdf9de
JWT_SECRET=27eff508c56e79e24484a10cf6b8cf8f99c1c924c596af1e096427a830cbce3c
JWT_REFRESH_SECRET=4e061f232a689beb86fd4a2e336fcf107b0451ca42200306fd592f3be73a8d76

# LibreChat conversation search. Meilisearch stays on the private compose network.
SEARCH=true
MEILI_HOST=http://meilisearch:7700
MEILI_MASTER_KEY=JW6YdUOnmNZksxcNAI2NhjXilUzfXt2kQHAPcOKQf/KDTAbV
MEILI_NO_ANALYTICS=true

# LDAP creates the user on first login; keep true.
ALLOW_REGISTRATION=true
ALLOW_EMAIL_LOGIN=true
ALLOW_SOCIAL_LOGIN=false

# Keep the same moderation and anti-abuse settings as the running stack. The
# moderation provider is disabled, so its key is retained only for completeness.
OPENAI_MODERATION=false
OPENAI_MODERATION_API_KEY=
BAN_VIOLATIONS=false
LIMIT_CONCURRENT_MESSAGES=false
LIMIT_MESSAGE_IP=false
LIMIT_MESSAGE_USER=false
LIMIT_IMPORT_IP=false
LIMIT_IMPORT_USER=false
LIMIT_FORK_IP=false
LIMIT_FORK_USER=false

# ---- Azure AI Foundry: the ONLY egress from this stack ----------------------
# No trailing slash on the base URL -- LibreChat appends /chat/completions
# itself. AZURE_FOUNDRY_MODEL is the DEPLOYMENT name. Verify with:
#   ./scripts/verify.sh V11
AZURE_FOUNDRY_BASE_URL=CHANGE_ME
AZURE_FOUNDRY_API_KEY=CHANGE_ME
AZURE_FOUNDRY_MODEL=gpt-5-mini
# Deprecated and ignored: conversation titles use the selected agent model.
AZURE_FOUNDRY_TITLE_MODEL=gpt-5-mini

# ---- Code Interpreter (ClickHouse/code-interpreter, self-hosted) -----------
LIBRECHAT_CODE_BASEURL=http://codeapi:3112/v1

# LOAD-BEARING: must stay `none`. codeapi runs LOCAL_MODE=true and never reads
# the Authorization header; setting librechat-jwt/both without key material
# throws at TOOL-EXECUTE time, silently costing execute_code and all data
# access (Cube tools are code_execution-only). See docs/TRAPS.md.
CODEAPI_AUTH_PROVIDER=none
CODEAPI_INTERNAL_SERVICE_TOKEN=HDJBSuTuFyG3LWyi5ByS/tzrDOXsaIGdg+UWR1mN9cg=
CODEAPI_EGRESS_GRANT_SECRET=lu1gDDhlkbXxdpx4LTSQu/laMPl86xEWxyCU78qeho8=
CODEAPI_REDIS_PASSWORD=XLita8FoCjeFp0jubXYnVsBxbnmq
PTC_MODE=replay
JOB_TIMEOUT=300000

# /dev/kvm does not exist in Docker Desktop, so NsJail (host kernel, weaker
# isolation) runs instead of the libkrun microVM path.
KVM_ENABLED=false
SANDBOX_USE_CGROUPV2=false

# ---- Garage (S3 object storage for the sandbox, not MinIO) ------------------
# In the environment, not garage.toml: Garage refuses to start if a config file
# holding secrets is group/world-readable, which a bind mount always is.
GARAGE_RPC_SECRET=d96d8b65afaea52d3001e8e359e06b1eba476c6553f9f7c4d672944fb8d7a018
GARAGE_ADMIN_TOKEN=da88731de5c87966d855425580fbf2acab0ccff6c15970d88b92e46703cdff54

# Imported by scripts/init-garage.sh, not generated, so they stay deterministic.
# MINIO_ACCESS_KEY must be "GK" + 24 hex chars. MINIO_ prefix is what the
# file server (a plain S3/MinIO-JS client) reads; it works against Garage as-is.
MINIO_ENDPOINT=garage
MINIO_PORT=3900
MINIO_USE_SSL=false
MINIO_BUCKET=codeapi-files
MINIO_ACCESS_KEY=GK6da81c49637079ff0526699f
MINIO_SECRET_KEY=ed90076f9db8046e246dc47817dc2fd04657108fc6d5878373a985167c967ada

# ---- Profile + host port map (container ports are fixed) --------------------
# demo = masking ENFORCED | dev = Cube Playground, masking DISABLED. Never demo
# on dev -- CUBEJS_DEV_MODE=true disables member-level access control.
CUBE_MODE=demo

POSTGRES_HOST_PORT=55432
CUBE_API_HOST_PORT=4000
CUBE_PG_HOST_PORT=15432
SUPERSET_HOST_PORT=8088
LIBRECHAT_HOST_PORT=3080
# For verify.sh / manual use; LibreChat uses the internal network.
CODEAPI_HOST_PORT=3112

# Same image and flags; only the SQL username differs, which is what makes the
# masking contrast attributable to the semantic layer alone.
PGMCP_ANALYST_HOST_PORT=8001
PGMCP_ADMIN_HOST_PORT=8002

SUPERSET_MCP_HOST_PORT=5008
SUPERSET_MCP_READER_PASSWORD=w9kV5P5LylzvKtuPwWMVGQvU
