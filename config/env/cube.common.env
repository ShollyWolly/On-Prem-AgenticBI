# Shared by both Cube profiles. Mode-specific settings live in
# cube.dev.env / cube.demo.env.

# Postgres wire protocol -- off by default in Cube Core; no port means off.
CUBEJS_PG_SQL_PORT=15432

CUBEJS_SCHEMA_PATH=model

# Drop the GraphQL scope: smaller API surface, nothing here uses it.
CUBEJS_DEFAULT_API_SCOPES=meta,data,sql

CUBEJS_LOG_LEVEL=info
CUBEJS_TELEMETRY=false

# '***'/-1/false rather than the built-in NULL, so a member missing an explicit
# mask still masks VISIBLY instead of looking like missing data.
CUBEJS_ACCESS_POLICY_MASK_STRING=***
CUBEJS_ACCESS_POLICY_MASK_NUMBER=-1
CUBEJS_ACCESS_POLICY_MASK_BOOLEAN=false

# Default 1024, lowered so a leaking client pool trips a clear error instead of
# quietly eating Cube's heap.
CUBEJS_MAX_SESSIONS=128

# Every pooled connection re-authenticates this often with no password -- why
# cube.js returns the password unconditionally. See docs/TRAPS.md.
CUBESQL_AUTH_EXPIRE_SECS=300

# Headroom for the e-graph rewriter (default 10000/300/-); Superset's generated
# SQL and the run_sql escape hatch are less predictable than the MCP builder.
CUBESQL_REWRITE_MAX_NODES=40000
CUBESQL_REWRITE_MAX_ITERATIONS=600
CUBESQL_REWRITE_TIMEOUT=30
