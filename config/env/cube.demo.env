# DEMO PROFILE -- masking ENFORCED. No Playground; verify via /readyz and :15432.
CUBEJS_DEV_MODE=false

# LOAD-BEARING: the cache/queue driver default keys on NODE_ENV (hardcoded
# 'production' in the image), not on CUBEJS_DEV_MODE, so leaving this unset
# resolves to 'cubestore' -- and with DEV_MODE=false Cube does not start the
# embedded cubestore-dev subprocess that dev mode relies on. The container comes
# up HEALTHY; only the first query throws. memory keeps this single-container;
# cost is no pre-aggregations, irrelevant at 16k rows.
CUBEJS_CACHE_AND_QUEUE_DRIVER=memory

# For pre-aggregations instead: comment the line above, uncomment these two,
# and run  docker compose --profile cubestore up -d
# CUBEJS_CACHE_AND_QUEUE_DRIVER=cubestore
# CUBEJS_CUBESTORE_HOST=cubestore

# CUBEJS_SQL_SUPER_USER stays unset, and cube.js pins canSwitchSqlUser: false.
# Our connections carry identity already (one pool per role), so there is
# nothing to re-scope -- and with an unrestricted MCP server in front, it would
# be the one lever an agent could pull to escalate. Cube refuses it itself;
# verify.sh V4 asserts the refusal.
