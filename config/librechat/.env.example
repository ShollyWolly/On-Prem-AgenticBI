# These values configure LibreChat's local session, OIDC, and service connections.
HOST=0.0.0.0
PORT=3080
MONGO_URI=mongodb://mongodb:27017/LibreChat
DOMAIN_CLIENT=http://localhost:3080
DOMAIN_SERVER=http://localhost:3080
CONFIG_PATH=/app/librechat.yaml

CREDS_KEY=CHANGE_ME_CREDS_KEY
CREDS_IV=CHANGE_ME_CREDS_IV
JWT_SECRET=CHANGE_ME_JWT_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_JWT_REFRESH_SECRET
OPENID_SESSION_SECRET=CHANGE_ME_OPENID_SESSION_SECRET
OPENID_ALLOW_INSECURE_HTTP=true
OPENID_CLIENT_ID=librechat
OPENID_CLIENT_SECRET=CHANGE_ME_AUTHENTIK_LIBRECHAT_CLIENT_SECRET

SEARCH=true
MEILI_HOST=http://meilisearch:7700
MEILI_MASTER_KEY=CHANGE_ME_MEILI_MASTER_KEY
MEILI_NO_ANALYTICS=true

ALLOW_REGISTRATION=false
ALLOW_EMAIL_LOGIN=false
ALLOW_SOCIAL_LOGIN=true
OPENAI_MODERATION=false
OPENAI_MODERATION_API_KEY=
BAN_VIOLATIONS=false
LIMIT_CONCURRENT_MESSAGES=false
LIMIT_MESSAGE_IP=false
LIMIT_MESSAGE_USER=false
LIMIT_IMPORT_IP=false
LIMIT_IMPORT_USER=false
LIMIT_FORK_IP=false
LIMIT_FORK_USER=false
LIBRECHAT_CODE_BASEURL=http://codeapi:3112/v1
CODEAPI_AUTH_PROVIDER=none
